// Working with strings. A `str` is UTF-8 text; positions are in characters
// unless a name says bytes.

import std.raw

pub fn chars(s: str) -> [char] {
    var out: [char] = []
    for c in s { out.push(c) }
    out
}

/// Number of characters, which is not `s.len` (bytes) outside ASCII.
pub fn count(s: str) -> int {
    var n = 0
    for c in s { n += 1 }
    n
}

pub fn from_chars(cs: [char]) -> str { raw.from_chars(cs) }

/// The strings of `parts`, one after another.
pub fn concat(parts: [str]) -> str { raw.concat(parts) }

/// Builds a long string out of pieces without copying it at every step.
pub struct Builder {
    parts: [str]
}

impl Builder {
    pub fn new() -> Builder { Builder(parts: []) }

    pub fn add(mut self, piece: str) { self.parts.push(piece) }

    pub fn add_char(mut self, c: char) { self.parts.push("{c}") }

    /// Adds a piece and ends the line.
    pub fn line(mut self, piece: str) {
        self.parts.push(piece)
        self.parts.push("\n")
    }

    pub fn is_empty(self) -> bool { self.parts.len == 0 }

    pub fn build(self) -> str { raw.concat(self.parts) }
}

/// Bytes a character takes in UTF-8.
fn width(c: char) -> int {
    let n = c as int
    if n < 128 { 1 } else if n < 2048 { 2 } else if n < 65536 { 3 } else { 4 }
}

pub fn is_space(c: char) -> bool { c == ' ' || c == '\t' || c == '\n' || c == '\r' }

pub fn is_digit(c: char) -> bool { c >= '0' && c <= '9' }

pub fn is_alpha(c: char) -> bool { (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }

/// The value of a decimal digit.
pub fn digit(c: char) -> int? {
    if is_digit(c) { Some(c as int - '0' as int) } else { None }
}

/// The pieces of `s` between occurrences of `sep`.
pub fn split(s: str, sep: char) -> [str] {
    var parts: [str] = []
    var start = 0
    var at = 0
    for c in s {
        if c == sep {
            parts.push(s[start..at])
            start = at + width(c)
        }
        at += width(c)
    }
    parts.push(s[start..at])
    parts
}

/// The words of `s`: its pieces between runs of white space.
pub fn words(s: str) -> [str] {
    var parts: [str] = []
    var start = 0
    var at = 0
    var inside = false
    for c in s {
        if is_space(c) {
            if inside { parts.push(s[start..at]) }
            inside = false
        } else if !inside {
            inside = true
            start = at
        }
        at += width(c)
    }
    if inside { parts.push(s[start..at]) }
    parts
}

pub fn lines(s: str) -> [str] { split(s, '\n') }

pub fn join(parts: [str], sep: str) -> str {
    var all: [str] = []
    for p in parts {
        if all.len > 0 { all.push(sep) }
        all.push(p)
    }
    raw.concat(all)
}

/// `s` without white space at either end.
pub fn trim(s: str) -> str {
    var start = 0
    var end = 0
    var at = 0
    var seen = false
    for c in s {
        if !is_space(c) {
            if !seen { start = at }
            seen = true
            end = at + width(c)
        }
        at += width(c)
    }
    if seen { s[start..end] } else { "" }
}

pub fn starts_with(s: str, prefix: str) -> bool {
    s.len >= prefix.len && s[..prefix.len] == prefix
}

pub fn ends_with(s: str, suffix: str) -> bool {
    s.len >= suffix.len && s[s.len - suffix.len..] == suffix
}

/// Byte position of the first occurrence of `part`, to slice with: `s[at..]`.
pub fn find(s: str, part: str) -> int? {
    let hay = chars(s)
    let needle = chars(part)
    let n = hay.len as int
    let m = needle.len as int
    var at = 0
    var i = 0
    while i + m <= n {
        var j = 0
        while j < m && hay[i + j] == needle[j] { j += 1 }
        if j == m { return at }
        at += width(hay[i])
        i += 1
    }
    None
}

pub fn contains(s: str, part: str) -> bool {
    match find(s, part) {
        Some(_) => true
        None => false
    }
}

pub fn repeat(s: str, times: int) -> str where times >= 0 {
    var parts: [str] = []
    for i in 0..times { parts.push(s) }
    raw.concat(parts)
}

/// The integer a decimal string holds, with an optional sign.
/// `None` when it is not a number or does not fit in `int`.
pub fn parse_int(s: str) -> int? {
    var n = 0
    var any = false
    var negative = false
    var first = true
    for c in s {
        if first && (c == '-' || c == '+') {
            negative = c == '-'
        } else {
            let d = digit(c)?
            // Built towards the negative side, which holds one more value.
            if n < (-9223372036854775807 - 1 + d) / 10 { return None }
            n = n * 10 - d
            any = true
        }
        first = false
    }
    if !any { return None }
    if negative { return n }
    if n == -9223372036854775807 - 1 { None } else { Some(0 - n) }
}

/// The number a decimal text holds: a sign, digits, a fraction and an
/// exponent, as in `-12.5e3`. `None` when it is anything else.
pub fn parse_float(s: str) -> f64? { raw.parse_float(s) }

/// The bytes of a string: its characters in UTF-8.
pub fn bytes(s: str) -> [u8] {
    var out: [u8] = []
    for ch in chars(s) {
        let c = ch as int
        if c < 128 {
            out.push(c as u8)
        } else if c < 2048 {
            out.push((192 + c / 64) as u8)
            out.push((128 + c % 64) as u8)
        } else if c < 65536 {
            out.push((224 + c / 4096) as u8)
            out.push((128 + c / 64 % 64) as u8)
            out.push((128 + c % 64) as u8)
        } else {
            out.push((240 + c / 262144) as u8)
            out.push((128 + c / 4096 % 64) as u8)
            out.push((128 + c / 64 % 64) as u8)
            out.push((128 + c % 64) as u8)
        }
    }
    out
}

/// The string some bytes are, or nothing when they are not UTF-8.
pub fn from_bytes(data: [u8]) -> str? {
    var out: [char] = []
    var i: usize = 0
    while i < data.len {
        let b = data[i] as int
        var more = 0
        var c = b
        var least = 0
        if b >= 240 {
            more = 3
            c = b - 240
            least = 65536
        } else if b >= 224 {
            more = 2
            c = b - 224
            least = 2048
        } else if b >= 192 {
            more = 1
            c = b - 192
            least = 128
        } else if b >= 128 {
            return None
        }
        if b >= 248 { return None }
        for k in 0..more {
            i += 1
            if i >= data.len { return None }
            let next = data[i] as int
            if next < 128 || next >= 192 { return None }
            c = c * 64 + (next - 128)
        }
        // The shortest form only, and no half of a pair of UTF-16.
        if c < least || c > 1114111 || (c >= 55296 && c <= 57343) { return None }
        out.push(c as char)
        i += 1
    }
    Some(from_chars(out))
}
