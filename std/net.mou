// TCP connections and UDP datagrams, over IPv4 and IPv6.
//
// Every function here waits until it is done. To serve several
// connections at once, each one goes in a task (a task that waits does
// not stop the others), or one task asks `wait` which of them have
// something to read and only reads from those.
//
// It is made of functions of C, so a program that uses it runs compiled
// (`mou build`), not with `mou run`. For now it only works on Linux.

import std.raw
import std.socket
import std.text

pub enum Error {
    /// The address is not four numbers from 0 to 255 with dots between,
    /// nor groups of hex digits with colons between, nor a name that
    /// anyone answers for.
    BadAddress(str)
    /// The system said no: what was being done.
    Failed(str)
    /// The other side closed the connection.
    Closed
}

/// A port of this machine that waits for connections.
pub struct Listener { fd: int }

/// A connection: bytes go in both directions.
pub struct Conn { fd: int }

/// The four numbers of an address written with dots, or nothing when the
/// text is not that.
fn numbers(host: str) -> [u8]? {
    let parts = text.split(host, '.')
    if parts.len != 4 { return None }
    var out: [u8] = []
    for part in parts {
        match text.parse_int(part) {
            Some(n) => {
                if n < 0 || n > 255 { return None }
                out.push(n as u8)
            }
            None => return None
        }
    }
    Some(out)
}

/// What a hex digit is worth, or nothing when the character is not one.
fn hex(c: char) -> int? {
    var k = 0
    for d in "0123456789abcdef" {
        if d == text.to_lower(c) { return Some(k) }
        k += 1
    }
    None
}

/// The 16 bytes of an address of IPv6: up to eight groups of hex digits
/// with colons between, where `::` stands, once, for the groups of zeros
/// that are missing. Nothing when the text is not that.
fn six(host: str) -> [u8]? {
    let cs = text.chars(host)
    let n = cs.len as int
    var before: [int] = []
    var after: [int] = []
    var gap = false
    // Whether the last thing read was the `::`.
    var at_gap = false
    var group = 0
    var digits = 0
    var k = 0
    while k < n {
        let c = cs[k]
        if c == ':' {
            let double = k + 1 < n && cs[k + 1] == ':'
            if double && gap { return None }
            if digits > 0 {
                if gap { after.push(group) } else { before.push(group) }
            } else if !double || k > 0 {
                return None
            }
            group = 0
            digits = 0
            if double {
                gap = true
                at_gap = true
                k += 2
            } else {
                k += 1
            }
            continue
        }
        match hex(c) {
            Some(d) => {
                if digits == 4 { return None }
                group = group * 16 + d
                digits += 1
                at_gap = false
            }
            None => return None
        }
        k += 1
    }
    if digits > 0 {
        if gap { after.push(group) } else { before.push(group) }
    } else if !at_gap {
        return None
    }
    let have = before.len as int + after.len as int
    if gap && have > 7 { return None }
    if !gap && have != 8 { return None }
    var out: [u8] = []
    for g in before {
        out.push((g / 256) as u8)
        out.push((g % 256) as u8)
    }
    for zero in 0..((8 - have) * 2) { out.push(0) }
    for g in after {
        out.push((g / 256) as u8)
        out.push((g % 256) as u8)
    }
    Some(out)
}

/// An address of IPv6 as it is written: the groups in hex without the
/// zeros in front, and `::` for the longest run of two or more groups of
/// zeros (the first one when two are as long).
fn six_text(bytes: [u8]) -> str {
    var groups: [int] = []
    for k in 0..8 { groups.push((bytes[k * 2] as int) * 256 + (bytes[k * 2 + 1] as int)) }
    var best = -1
    var best_len = 1
    var k = 0
    while k < 8 {
        var run = 0
        while k + run < 8 && groups[k + run] == 0 { run += 1 }
        if run > best_len {
            best = k
            best_len = run
        }
        k += if run > 0 { run } else { 1 }
    }
    let digits = text.chars("0123456789abcdef")
    var out = text.Builder.new()
    k = 0
    while k < 8 {
        if k == best {
            out.add("::")
            k += best_len
            continue
        }
        if k > 0 && k != best + best_len { out.add(":") }
        var started = false
        for unit in [4096, 256, 16, 1] {
            let d = (groups[k] / unit) % 16
            if d != 0 || started || unit == 1 {
                out.add_char(digits[d])
                started = true
            }
        }
        k += 1
    }
    out.build()
}

/// The bytes of an address that is written out, with dots or with
/// colons: 4 or 16. Nothing when the text is neither.
fn written(host: str) -> [u8]? {
    if text.contains(host, ":") { return six(host) }
    numbers(host)
}

/// The addresses a name stands for, as the system finds them (its file of
/// hosts, DNS): the ones of IPv4 first, written with dots, and then the
/// ones of IPv6, written with colons. An address that is written out
/// already gives itself.
pub fn resolve(host: str) -> [str] ! Error {
    if text.contains(host, ":") {
        match six(host) {
            Some(_) => return [host]
            None => return Error.BadAddress(host)
        }
    }
    // Numbers and dots are an address, well written or not: never a name.
    var name = false
    for c in host {
        if c != '.' && !text.is_digit(c) { name = true }
    }
    if !name {
        match numbers(host) {
            Some(_) => return [host]
            None => return Error.BadAddress(host)
        }
    }
    let found = raw.resolve(host) catch e { return Error.BadAddress(host) }
    if found.len == 0 { return Error.BadAddress(host) }
    found
}

/// The address as the system takes it: 16 bytes for IPv4, 28 for IPv6.
/// A name is looked up, and the first address it has is the one used.
fn address(host: str, port: int) -> [u8] ! Error {
    if port < 0 || port > 65535 { return Error.BadAddress("{host}:{port}") }
    var bytes: [u8] = []
    match written(host) {
        Some(ns) => { bytes = ns }
        None => {
            match written(resolve(host)?[0]) {
                Some(ns) => { bytes = ns }
                None => return Error.BadAddress(host)
            }
        }
    }
    if bytes.len == 16 {
        // The family, the port, four bytes of flow, the address and four
        // bytes of scope.
        var out: [u8] = [10, 0, (port / 256) as u8, (port % 256) as u8, 0, 0, 0, 0]
        for n in bytes { out.push(n) }
        for k in 0..4 { out.push(0) }
        return out
    }
    var out: [u8] = [2, 0, (port / 256) as u8, (port % 256) as u8]
    for n in bytes { out.push(n) }
    for k in 0..8 { out.push(0) }
    out
}

/// The address a socket gave, as it is written.
fn shown(addr: [u8]) -> str {
    if addr[0] == 10 { return six_text(addr[8..24]) }
    "{addr[4]}.{addr[5]}.{addr[6]}.{addr[7]}"
}

/// Starts to wait for connections on a port of an address of this
/// machine: `"127.0.0.1"` or `"::1"` for programs of this machine only,
/// `"0.0.0.0"` or `"::"` for anyone. With port 0 the system picks a free one.
pub fn listen(host: str, port: int) -> Listener ! Error {
    let addr = address(host, port)?
    let fd = socket.open(addr.len > 16)
    if fd < 0 { return Error.Failed("open a socket") }
    let one: [i32] = [1]
    if !socket.reuse(fd, one) || !socket.bind(fd, addr) || !socket.listen(fd) {
        socket.close(fd)
        return Error.Failed("listen on {host}:{port}")
    }
    Listener(fd)
}

/// Connects to a port of an address.
pub fn connect(host: str, port: int) -> Conn ! Error {
    let addr = address(host, port)?
    let fd = socket.open(addr.len > 16)
    if fd < 0 { return Error.Failed("open a socket") }
    if !socket.connect(fd, addr) {
        socket.close(fd)
        return Error.Failed("connect to {host}:{port}")
    }
    Conn(fd)
}

/// What `wait` found: whether someone is waiting to connect, and the
/// positions of the connections that have something to read.
pub struct Ready { accept: bool, conns: [int] }

/// One socket as `poll` takes it: its number, and that it is asked
/// whether there is something to read. The bytes are in the order of
/// this machine, which is the one of x86 and ARM.
fn asked(fds: mut [u8], fd: int) {
    for k in 0..4 { fds.push(((fd >> (8 * k)) & 255) as u8) }
    let want = socket.readable()
    fds.push((want & 255) as u8)
    fds.push(((want >> 8) & 255) as u8)
    fds.push(0)
    fds.push(0)
}

/// Waits until someone connects to `server` or one of `conns` has
/// something to read, up to `ms` milliseconds; forever when `ms` is
/// negative. With nothing in the time given, what comes back is empty.
/// A connection the other side closed counts as having something to
/// read: reading it gives the empty array. After this, `accept` and
/// `read` on what it names do not wait.
pub fn wait(server: Listener?, conns: [Conn], ms: int) -> Ready ! Error {
    var fds: [u8] = []
    var first = 0
    if let Some(l) = server {
        asked(mut fds, l.fd)
        first = 1
    }
    for c in conns { asked(mut fds, c.fd) }
    let count = first + (conns.len as int)
    if socket.poll(mut fds, count, ms) < 0 { return Error.Failed("wait for the connections") }
    var out = Ready(false, [])
    for k in 0..count {
        // What the system found is in the last two bytes of each one.
        if fds[(8 * k + 6) as usize] == 0 && fds[(8 * k + 7) as usize] == 0 { continue }
        if k < first { out.accept = true } else { out.conns.push(k - first) }
    }
    out
}

impl Listener {
    /// The port it waits on: the one the system picked when it was 0.
    pub fn port(self) -> int ! Error {
        var addr: [u8] = [0; 28]
        var len: [u32] = [28]
        if !socket.name(self.fd, mut addr, mut len) { return Error.Failed("ask for the port") }
        (addr[2] as int) * 256 + (addr[3] as int)
    }

    /// Waits until someone connects.
    pub fn accept(self) -> Conn ! Error {
        let fd = socket.accept(self.fd)
        if fd < 0 { return Error.Failed("accept a connection") }
        Conn(fd)
    }

    pub fn close(self) { socket.close(self.fd) }
}

impl Conn {
    /// Sends all the bytes.
    pub fn write(self, data: [u8]) ! Error {
        var left = data
        while left.len > 0 {
            let n = socket.send(self.fd, left, left.len)
            if n <= 0 { return Error.Closed }
            left = left[(n as usize)..]
        }
    }

    /// Sends a text, as UTF-8.
    pub fn send(self, message: str) ! Error { self.write(text.bytes(message))? }

    /// Waits for bytes: up to `max` of the ones that came. An empty array
    /// means the other side will send nothing more.
    pub fn read(self, max: int) -> [u8] ! Error where max > 0 {
        var data: [u8] = [0; max as usize]
        let n = socket.recv(self.fd, mut data)
        if n < 0 { return Error.Failed("read from the connection") }
        data[..(n as usize)]
    }

    /// Reads until the other side sends nothing more.
    pub fn read_all(self) -> [u8] ! Error {
        var all: [u8] = []
        while true {
            let piece = self.read(4096)?
            if piece.len == 0 { break }
            for b in piece { all.push(b) }
        }
        all
    }

    /// Says that nothing more will be sent; what the other side sends can
    /// still be read.
    pub fn finish(self) { socket.finish(self.fd) }

    pub fn close(self) { socket.close(self.fd) }
}

/// A port of this machine that sends and receives datagrams (UDP): each
/// one goes whole or does not go, and nothing says whether it arrived.
pub struct Udp { fd: int }

/// A datagram that came, and who sent it.
pub struct Packet { data: [u8], host: str, port: int }

/// Opens a port for datagrams on an address of this machine. With port 0
/// the system picks a free one.
pub fn udp(host: str, port: int) -> Udp ! Error {
    let addr = address(host, port)?
    let fd = socket.open_datagram(addr.len > 16)
    if fd < 0 { return Error.Failed("open a socket") }
    if !socket.bind(fd, addr) {
        socket.close(fd)
        return Error.Failed("take {host}:{port}")
    }
    Udp(fd)
}

impl Udp {
    /// The port it has: the one the system picked when it was 0.
    pub fn port(self) -> int ! Error {
        var addr: [u8] = [0; 28]
        var len: [u32] = [28]
        if !socket.name(self.fd, mut addr, mut len) { return Error.Failed("ask for the port") }
        (addr[2] as int) * 256 + (addr[3] as int)
    }

    /// Sends the bytes as one datagram to a port of an address.
    pub fn send_to(self, host: str, port: int, data: [u8]) ! Error {
        let addr = address(host, port)?
        if socket.send_to(self.fd, data, data.len, addr) != data.len as int { return Error.Failed("send a datagram to {host}:{port}") }
    }

    /// Waits for a datagram: its first `max` bytes at most, and who sent it.
    pub fn receive(self, max: int) -> Packet ! Error where max > 0 {
        var data: [u8] = [0; max as usize]
        var addr: [u8] = [0; 28]
        var len: [u32] = [28]
        let n = socket.recv_from(self.fd, mut data, mut addr, mut len)
        if n < 0 { return Error.Failed("receive a datagram") }
        Packet(data[..(n as usize)], shown(addr), (addr[2] as int) * 256 + (addr[3] as int))
    }

    pub fn close(self) { socket.close(self.fd) }
}

/// What happened to a connection of a `Server`. The number names the
/// connection: it is the one to answer or to close.
pub enum Event {
    /// Someone connected.
    Open(int)
    /// Bytes came.
    Data(int, [u8])
    /// The other side will send nothing more. It can still be answered; the
    /// connection stays until it is closed.
    Done(int)
}

/// Many connections served from one task: `next` waits until something
/// happens and says what, and the program answers. It keeps the list of
/// connections, so the program does not.
///
///     var server = net.Server.on(net.listen("0.0.0.0", 8080)?)
///     while true {
///         for event in server.next(-1)? {
///             match event {
///                 Data(who, bytes) => { server.send(who, bytes)? }
///                 Done(who) => { server.close(who) }
///                 Open(_) => {}
///             }
///         }
///     }
pub struct Server {
    listener: Listener,
    conns: [Conn],
    // The number each connection is known by, and whether its end was told.
    names: [int],
    ended: [bool],
    made: int,
}

impl Server {
    pub fn on(listener: Listener) -> Server { Server(listener, [], [], [], 0) }

    /// How many connections are open.
    pub fn len(self) -> int { self.conns.len as int }

    fn place(self, who: int) -> int? {
        for k in 0..(self.names.len as int) {
            if self.names[k] == who { return Some(k) }
        }
        None
    }

    /// Waits until something happens, up to `ms` milliseconds (forever when
    /// negative), and says what: nothing when the time ran out.
    pub fn next(mut self, ms: int) -> [Event] ! Error {
        // A connection that ended is not asked about again.
        var asked: [Conn] = []
        var places: [int] = []
        for k in 0..(self.conns.len as int) {
            if !self.ended[k] {
                asked.push(self.conns[k])
                places.push(k)
            }
        }
        let ready = wait(Some(self.listener), asked, ms)?
        var events: [Event] = []
        for at in ready.conns {
            let k = places[at]
            let piece = self.conns[k].read(65536)?
            if piece.len == 0 {
                self.ended[k] = true
                events.push(Event.Done(self.names[k]))
            } else {
                events.push(Event.Data(self.names[k], piece))
            }
        }
        if ready.accept {
            let conn = self.listener.accept()?
            self.made += 1
            self.conns.push(conn)
            self.names.push(self.made)
            self.ended.push(false)
            events.push(Event.Open(self.made))
        }
        events
    }

    /// Sends bytes to a connection.
    pub fn send(self, who: int, data: [u8]) ! Error {
        match self.place(who) {
            Some(k) => self.conns[k].write(data)?
            None => return Error.Closed
        }
    }

    /// Closes a connection, which leaves the server. Closing one that is
    /// not there does nothing.
    pub fn close(mut self, who: int) {
        let k = match self.place(who) {
            Some(k) => k
            None => return
        }
        self.conns[k].close()
        var conns: [Conn] = []
        var names: [int] = []
        var ended: [bool] = []
        for i in 0..(self.conns.len as int) {
            if i != k {
                conns.push(self.conns[i])
                names.push(self.names[i])
                ended.push(self.ended[i])
            }
        }
        self.conns = conns
        self.names = names
        self.ended = ended
    }

    /// Closes every connection and stops waiting for more.
    pub fn stop(mut self) {
        for c in self.conns { c.close() }
        self.conns = []
        self.names = []
        self.ended = []
        self.listener.close()
    }
}
