import std.io
struct P { x: int, tags: [str] }
enum Tree { Leaf, Node(Tree?, int) }
fn first(xs: [int]) -> int where xs.len > 0 { xs[0] }
fn item(xs: [int], i: usize) -> int where i < xs.len { xs[i] }
fn twice(n: int) -> int { n * 2 }
fn say() ! io.Error { io.print("x")? }

