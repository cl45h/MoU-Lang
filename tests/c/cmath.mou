// A `system` module over headers of C that are read when the program is
// compiled: `import c` without the functions written out.
@profile(system)

import c "math.h" as m
import c "string.h" as cs
import c "ctype.h" as ct
import c "stdlib.h" as lib

pub fn hyp(a: f64, b: f64) -> f64 { unsafe { m.hypot(a, b) } }

pub fn larger(a: f64, b: f64) -> f64 { unsafe { m.fmax(a, b) } }

pub fn parts(x: f64, whole: mut [f64]) -> f64 { unsafe { m.modf(x, mut whole) } }

pub fn span(s: str, accept: str) -> u64 { unsafe { cs.strspn(s, accept) } }

pub fn upper(c: char) -> char { unsafe { ct.toupper(c as i32) as char } }

pub fn number(s: str) -> i64 { unsafe { lib.strtol(s, None, 10) } }

/// The text from the first `c` on, when there is one.
pub fn from(s: str, c: char) -> str? { unsafe { cs.strchr(s, c as i32) } }
