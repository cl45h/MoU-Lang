mou> import std.io
import std.text
fn double(n: int) -> int { n * 2 }
struct P { x: int }
fn triple(n: int) -> int {
    n * 3
}
fn main() ! io.Error {
let _ = 1 + 2
var xs: [int] = [1, 2]
xs.push(3)
let _ = xs
let _ = xs.pop()
let _ = xs.len
io.print("{double(xs[1])} {P(4)}")?
let _ = text.words("a b")
for x in xs { io.print("{x}")? }
let _ = xs.len as int + double(1)
let _ = triple(5)
}
