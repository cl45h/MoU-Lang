import std.io

let SIZE = 4

fn total(xs: [int; 3]) -> int { xs[0] + xs[1] + xs[2] }

fn sum(comptime n: int, xs: [int; n]) -> int {
    var t = 0
    for x in xs { t += x }
    t
}

fn main() ! io.Error {
    let a: [int; 3] = [1, 2, 3]
    let b: [int; SIZE] = [0; 4]
    var c: [int; 2] = [5, 6]
    c[1] = 9
    io.print("{total(a)} {b.len} {c[1]} {sum(3, a)} {sum(2, c)} {sum(4, [1, 1, 1, 1])}")?
    let grid: [[int; 2]; 2] = [[1, 2], [3, 4]]
    io.print("{grid[1][0]}")?
    let mixed = if a.len > 2 { [1, 2] } else { [1, 2, 3] }
    io.print("{mixed.len}")?
}
