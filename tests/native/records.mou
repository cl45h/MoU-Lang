import std.io
struct Vec3 { x: f64, y: f64, z: f64 }
struct Counter { n: int, on: bool }
trait Shape { fn area(self) -> f64 }
impl Vec3 {
    fn add(self, b: Vec3) -> Vec3 { Vec3(self.x + b.x, self.y + b.y, self.z + b.z) }
    fn dot(self, b: Vec3) -> f64 { self.x * b.x + self.y * b.y + self.z * b.z }
    fn grow(mut self, k: f64) { self.x *= k
        self.y *= k }
}
impl Shape for Vec3 { fn area(self) -> f64 { self.x * self.y } }
impl Counter {
    fn bump(mut self) { if self.on { self.n += 1 } }
    fn get(self) -> int { self.n }
}
impl int { fn twice(self) -> int { self * 2 } }
fn main() ! io.Error {
    var p = Vec3(0.0, 0.0, 0.0)
    let step = Vec3(0.5, 0.25, 0.125)
    var acc = 0.0
    for i in 0..2000000 {
        p = p.add(step)
        acc += p.dot(step)
    }
    p.grow(2.0)
    var c = Counter(0, true)
    for i in 0..10 { c.bump() }
    var shapes: [dyn Shape] = []
    shapes.push(p as dyn Shape)
    shapes.push(step as dyn Shape)
    var total = 0.0
    for s in shapes { total += s.area() }
    io.print("{acc} {p.x} {c.get()} {total} {4.twice()} {p}")?
}
