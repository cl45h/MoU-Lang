import std.io

enum Shape { Dot, Circle(f64), Rect(f64, f64) }
enum Ev { Key(int), Click(int, int), Quit, Wheel(i8) }
enum Mixed { A(int), B(f64) }

fn area(s: Shape) -> f64 {
    match s {
        Shape.Dot => 0.0
        Shape.Circle(r) => 3.0 * r * r
        Shape.Rect(w, h) => w * h
    }
}
fn grow(s: Shape, by: f64) -> Shape {
    match s {
        Shape.Dot => Shape.Dot
        Shape.Circle(r) => Shape.Circle(r + by)
        Shape.Rect(w, h) => Shape.Rect(w + by, h + by)
    }
}
fn code(e: Ev) -> int {
    match e {
        Ev.Key(k) => k
        Ev.Click(x, y) => x * 1000 + y
        Ev.Quit => 0 - 1
        Ev.Wheel(d) => d as int
    }
}
fn next(e: mut Ev) {
    e = match e {
        Ev.Key(k) => Ev.Click(k, k + 1)
        Ev.Click(x, y) => Ev.Wheel(0 - 4)
        _ => Ev.Quit
    }
}
fn mixed(m: Mixed) -> int {
    match m {
        Mixed.A(n) => n
        Mixed.B(x) => x as int
    }
}

fn main() ! io.Error {
    var total = 0.0
    for i in 0..300000 {
        let s = if i % 3 == 0 { Shape.Dot } else { if i % 3 == 1 { Shape.Circle(1.0) } else { Shape.Rect(2.0, 0.5) } }
        total += area(grow(s, 1.0))
    }
    var e = Ev.Key(7)
    var codes: [int] = []
    for i in 0..4 {
        codes.push(code(e))
        next(mut e)
    }
    let all = [Shape.Dot, Shape.Circle(2.0), grow(Shape.Rect(1.0, 1.0), 0.5)]
    var sum = 0.0
    for s in all { sum += area(s) }
    let same = Shape.Circle(2.0) == all[1] && Shape.Dot == all[0] && Shape.Dot != all[2]
    io.print("{total} {codes[0]} {codes[1]} {codes[2]} {codes[3]} {sum} {same} {all[2]} {e} {mixed(Mixed.B(2.5)) + mixed(Mixed.A(1))}")?
}
