import std.io

trait Named {
    fn name(self) -> str
    fn greet(self) -> str { "hola, {self.name()}" }
    fn twice(self) -> str { "{self.greet()} y {self.greet()}" }
}

trait Shape: Named {
    fn area(self) -> f64
    fn bigger(self, other: Self) -> bool { self.area() > other.area() }
    fn label(self) -> str { "{self.name()} de {self.area()}" }
    fn unit() -> str { "m2" }
}

struct Square { side: f64 }
struct Circle { r: f64 }
struct Box[T] { item: T }

impl Named for Square { fn name(self) -> str { "cuadrado" } }
impl Named for Circle {
    fn name(self) -> str { "círculo" }
    fn greet(self) -> str { "buenas, {self.name()}" }
}
impl Shape for Square { fn area(self) -> f64 { self.side * self.side } }
impl Shape for Circle {
    fn area(self) -> f64 { 3.0 * self.r * self.r }
    fn unit() -> str { "cm2" }
}
impl Named for int { fn name(self) -> str { "entero {self}" } }
impl[T: Named] Named for Box[T] { fn name(self) -> str { "caja con {self.item.name()}" } }

fn show[T: Shape](a: T, b: T) -> str {
    "{a.label()} / {b.greet()} / {a.bigger(b)}"
}

fn main() ! io.Error {
    let s = Square(side: 2.0)
    let c = Circle(r: 1.0)
    io.print("{s.greet()} | {c.greet()} | {s.twice()} | {c.twice()}")?
    io.print("{s.label()} | {c.label()} | {s.bigger(Square(side: 1.0))}")?
    io.print("{Square.unit()} {Circle.unit()}")?
    io.print(show(s, Square(side: 3.0)))?
    io.print(show(c, Circle(r: 0.5)))?
    io.print("{7.greet()} | {Box(item: 3).twice()} | {Box(item: Box(item: 1)).greet()}")?
}
