import std.io

trait Named {
    fn name(self) -> str
    fn greet(self) -> str { "hola, {self.name()}" }
}

trait Shape: Named {
    fn area(self) -> f64
    fn grow(mut self, by: f64)
    fn bigger(self, other: Self) -> bool { self.area() > other.area() }
    fn unit() -> str { "m2" }
}

struct Square { side: f64 }
struct Circle { r: f64 }
struct Wrap[T] { item: T, times: int }

impl Named for Square { fn name(self) -> str { "cuadrado" } }
impl Named for Circle {
    fn name(self) -> str { "círculo" }
    fn greet(self) -> str { "buenas, {self.name()}" }
}
impl Shape for Square {
    fn area(self) -> f64 { self.side * self.side }
    fn grow(mut self, by: f64) { self.side = self.side + by }
}
impl Shape for Circle {
    fn area(self) -> f64 { 3.0 * self.r * self.r }
    fn grow(mut self, by: f64) { self.r = self.r * by }
}
impl Named for int { fn name(self) -> str { "entero {self}" } }
impl[T: Named] Named for Wrap[T] { fn name(self) -> str { "{self.times} de {self.item.name()}" } }

struct Scene { shapes: [dyn Shape], title: str }

fn total(shapes: [dyn Shape]) -> f64 {
    var t = 0.0
    for s in shapes { t = t + s.area() }
    t
}

fn describe(n: dyn Named) -> str { "<{n.greet()}>" }

fn pack[T: Shape](x: T) -> dyn Shape { x as dyn Shape }

fn main() ! io.Error {
    var shapes: [dyn Shape] = [Square(side: 2.0) as dyn Shape, Circle(r: 1.0) as dyn Shape]
    shapes.push(pack(Square(side: 1.0)))
    io.print("{total(shapes)} {shapes.len}")?
    for s in shapes { io.print("{s.name()}: {s.area()} | {s.greet()}")? }
    for i in 0..shapes.len as int { shapes[i].grow(2.0) }
    io.print("{total(shapes)} {shapes}")?

    var one = Circle(r: 2.0) as dyn Shape
    let copy = one
    one.grow(0.5)
    io.print("{one.area()} {copy.area()} {one} {copy}")?

    let names: [dyn Named] = [7 as dyn Named, Wrap(item: 3, times: 2) as dyn Named, Wrap(item: Circle(r: 1.0), times: 1) as dyn Named, "x".len as int as dyn Named]
    for n in names { io.print(describe(n))? }
    let again = names[1] as dyn Named
    io.print("{again.name()} {describe(Square(side: 1.0) as dyn Named)}")?

    var scene = Scene(shapes: shapes, title: "escena")
    scene.shapes[0].grow(1.0)
    io.print("{scene.shapes[0].area()} {shapes[0].area()} {scene.title}")?
    let maybe: dyn Shape? = Some(shapes[1])
    match maybe {
        Some(s) => io.print("{s.name()} {s.area()}")?
        None => io.print("nada")?
    }
}
