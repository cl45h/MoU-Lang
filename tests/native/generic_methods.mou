import std.io

trait Container {
    fn first(self) -> int
    fn map_first[U](self, f: fn(int) -> U) -> U
    fn pair[U](self, other: U) -> (int, U) { (self.first(), other) }
}

struct One { v: int }
struct Many { vs: [int] }

impl Container for One {
    fn first(self) -> int { self.v }
    fn map_first[U](self, f: fn(int) -> U) -> U { f(self.v) }
}

impl Container for Many {
    fn first(self) -> int { self.vs[0] }
    fn map_first[U](self, f: fn(int) -> U) -> U { f(self.vs[0]) }
    fn pair[U](self, other: U) -> (int, U) { (self.vs.len as int, other) }
}

fn describe[C: Container](c: C) -> str {
    let s = c.map_first(fn(n: int) -> str { "n={n}" })
    let p = c.pair(true)
    "{s} {p}"
}

fn main() ! io.Error {
    let o = One(4)
    let m = Many([7, 8])
    io.print("{o.map_first(fn(n: int) -> int { n * 2 })} {o.map_first(fn(n: int) -> str { "<{n}>" })} {o.pair('x')} {m.pair(1.5)}")?
    io.print("{describe(o)} | {describe(m)}")?
}
