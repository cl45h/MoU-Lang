import std.io
import std.math
import std.text

fn main() ! io.Error {
    io.print("{math.sqrt(2.0)} {math.sqrt(144.0)} {math.floor(-2.5)} {math.ceil(-2.5)} {math.round(2.5)} {math.round(-2.5)} {math.trunc(-2.9)}")?
    io.print("{math.sin(0.0)} {math.cos(0.0)} {math.atan2(1.0, 1.0) * 4.0 == math.PI} {math.exp(0.0)} {math.ln(math.E)} {math.log10(1000.0)} {math.log2(8.0)} {math.powf(2.0, 10.0)}")?
    io.print("{math.sin(1.0)} {math.cos(1.0)} {math.tan(1.0)} {math.asin(0.5)} {math.acos(0.5)} {math.atan(0.5)} {math.exp(1.5)} {math.powf(1.5, 2.5)}")?
    io.print("{text.upper("año nuevo, straße, я")} {text.lower("ÁRBOL ΣΟΦΙΑ İ")} {text.to_upper('ñ')} {text.to_lower('Ж')} {text.to_upper('1')}")?
    for c in "aZñ9٣ \t_Ж中" {
        io.print("{c}: {text.is_letter(c)} {text.is_number(c)} {text.is_blank(c)} {text.is_upper(c)} {text.is_lower(c)}")?
    }
}
