import std.io

struct Range { lo: i128, hi: i128 }
struct Span { r: Range, open: bool }

fn pow2(bits: int) -> i128 {
    var out: i128 = 1
    for k in 0..bits { out = out * 2 }
    out
}

let TOP: i128 = pow2(126) - 1 + pow2(126)
let BOTTOM: i128 = (0 - pow2(126)) * 2

fn hull(a: Range, b: Range) -> Range {
    Range(if a.lo < b.lo { a.lo } else { b.lo }, if a.hi > b.hi { a.hi } else { b.hi })
}

fn width(r: Range) -> i128 { r.hi - r.lo }

fn grow(r: mut Range, by: i128) {
    r.lo -= by
    r.hi += by
}

fn mixed(a: i128, b: int, c: u64) -> i128 { a * 3 + b as i128 - c as i128 / 2 }

fn overflow(a: i128) -> i128 { a + 1 }

fn main() ! io.Error {
    let all = Range(BOTTOM, TOP)
    let small = Range(-5, 9)
    io.print("{all.lo} {all.hi}")?
    io.print("{hull(small, Range(0, 100))} {width(small)} {hull(all, small) == all}")?
    var r = small
    grow(mut r, pow2(70))
    io.print("{r} {width(r)}")?
    let s = Span(r, true)
    io.print("{s.r.hi - s.r.lo} {s}")?
    io.print("{mixed(pow2(100), -7, 18446744073709551615)} {mixed(-1, 2, 3)}")?
    var x: i128 = pow2(60)
    x = x * x / 3 % 1000003
    x -= pow2(90)
    io.print("{x} {x / -7} {x % 10} {-x} {x < 0} {x as f64}")?
    var ranges: [Range] = []
    for k in 0..5 { ranges.push(Range(BOTTOM / 8 * k as i128, pow2(k * 20))) }
    var acc = Range(0, 0)
    for it in ranges { acc = hull(acc, it) }
    io.print("{acc} {ranges[4].hi} {ranges.len}")?
    var i: i128 = TOP - 3
    var steps = 0
    while i < TOP {
        i += 1
        steps += 1
    }
    io.print("{steps} {i == TOP} {(TOP as i128) > 0}")?
    io.print("{overflow(TOP)}")?
}
