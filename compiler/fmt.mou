// The formatter: gives a file the standard layout.
//
// It works on the text, not on the syntax tree, so comments stay where
// they are. It fixes the indentation, the spaces inside a line and the
// blank lines, and never moves anything to another line: where a line
// ends is the choice of whoever wrote it, and in this language it has a
// meaning. It follows `fmt.rs` of the first compiler (written in Rust, no longer here) step by step, and gives the same text.

import std.text
import lexer

pub struct Failed { msg: str }

let SPACE: int = 0
let NEWLINE: int = 1
let WORD: int = 2
let PUNCT: int = 3
let STR: int = 4
let CHAR: int = 5
let LINE_COMMENT: int = 6
let BLOCK_COMMENT: int = 7

struct Piece { kind: int, text: str }

// A piece of a line, and whether a space came before it.
struct Entry { had: bool, piece: Piece }

fn at(cs: [char], i: int, s: [char]) -> bool {
    if i + (s.len as int) > (cs.len as int) { return false }
    for k in 0..(s.len as int) {
        if cs[i + k] != s[k] { return false }
    }
    true
}

fn is_blank(c: char) -> bool {
    if (c as int) < 128 { return c == ' ' || (c >= '\t' && c <= '\r') }
    text.is_blank(c)
}

fn is_word(c: char) -> bool {
    if (c as int) < 128 { return text.is_alpha(c) || text.is_digit(c) || c == '_' }
    text.is_letter(c) || text.is_number(c)
}

// Cuts the source into pieces without losing a character.
fn scan(src: str) -> [Piece] ! Failed {
    let cs = text.chars(src)
    let n = cs.len as int
    var puncts: [[char]] = []
    for p in lexer.PUNCT { puncts.push(text.chars(p)) }
    let open = ['/', '*']
    let close = ['*', '/']
    var out: [Piece] = []
    var i = 0
    while i < n {
        let c = cs[i]
        let start = i
        var kind = PUNCT
        if c == '\n' {
            i += 1
            kind = NEWLINE
        } else if is_blank(c) {
            while i < n && cs[i] != '\n' && is_blank(cs[i]) { i += 1 }
            kind = SPACE
        } else if at(cs, i, ['/', '/']) {
            while i < n && cs[i] != '\n' { i += 1 }
            kind = LINE_COMMENT
        } else if at(cs, i, open) {
            var depth = 0
            loop {
                if at(cs, i, open) {
                    depth += 1
                    i += 2
                } else if at(cs, i, close) {
                    depth -= 1
                    i += 2
                    if depth == 0 { break }
                } else if i >= n {
                    return Failed("unterminated block comment")
                } else {
                    i += 1
                }
            }
            kind = BLOCK_COMMENT
        } else if is_word(c) {
            while i < n && is_word(cs[i]) { i += 1 }
            kind = WORD
        } else if c == '"' {
            i += 1
            loop {
                if i >= n { return Failed("unterminated string literal") }
                let d = cs[i]
                let twice = i + 1 < n && cs[i + 1] == d
                if d == '"' {
                    i += 1
                    break
                } else if d == '\\' {
                    i += 2
                } else if (d == '{' || d == '}') && twice {
                    i += 2
                } else if d == '{' {
                    // An expression inside the text ends at its closing brace.
                    i += 1
                    var depth = 1
                    while depth > 0 {
                        if i >= n { return Failed("unterminated `{{` in string interpolation") }
                        if cs[i] == '{' { depth += 1 }
                        if cs[i] == '}' { depth -= 1 }
                        i += 1
                    }
                } else {
                    i += 1
                }
            }
            kind = STR
        } else if c == '\'' {
            if i + 1 < n && cs[i + 1] == '\\' { i += 4 } else { i += 3 }
            if i > n { return Failed("unterminated character literal") }
            kind = CHAR
        } else {
            var found = false
            for p in puncts {
                if !found && at(cs, i, p) {
                    i += p.len as int
                    found = true
                }
            }
            if !found { return Failed("unexpected character `{c}`") }
        }
        var end = i
        if end > n { end = n }
        out.push(Piece(kind, text.from_chars(cs[start..end])))
    }
    out
}

// Operators that are always between two operands: a space on each side.
let SPACED: [str] = [
    "=", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "->", "=>", "+", "*",
    "/", "%", "<", ">", "<<", ">>", "+%", "-%", "*%", "+|", "-|", "*|"
]

fn punct(p: Piece, list: [str]) -> bool {
    if p.kind != PUNCT { return false }
    for s in list {
        if s == p.text { return true }
    }
    false
}

// Whether a space goes between two pieces of a line. `had` says whether
// one was written: it decides where the layout has no rule.
fn space(prev: Piece, cur: Piece, had: bool) -> bool {
    if cur.kind == LINE_COMMENT { return true }
    if cur.kind == BLOCK_COMMENT || prev.kind == BLOCK_COMMENT { return had }
    if punct(cur, [",", ";", ")", "]"]) || punct(prev, ["(", "["]) { return false }
    if punct(prev, [","]) { return true }
    if punct(cur, [":"]) { return false }
    if punct(prev, [":"]) { return true }
    if punct(cur, SPACED) || punct(prev, SPACED) { return true }
    if punct(prev, ["{{"]) { return !punct(cur, ["}}"]) }
    if punct(cur, ["{{", "}}"]) { return true }
    had
}

// The text of a file in the standard layout.
pub fn format(src: str) -> str ! Failed {
    let pieces = scan(src)?
    // The lines of the source, each with its pieces. A string or a
    // comment that spans lines is one piece.
    var lines: [[Entry]] = []
    var current: [Entry] = []
    var had = false
    for p in pieces {
        if p.kind == NEWLINE {
            lines.push(current)
            current = []
            had = false
        } else if p.kind == SPACE {
            had = true
        } else {
            current.push(Entry(had, p))
            had = false
        }
    }
    lines.push(current)
    let openers = ["{{", "(", "["]
    let closers = ["}}", ")", "]"]
    var out: [str] = []
    var depth = 0
    // Whether a blank line may come next: not at the start of the file or
    // of a block, and never two in a row.
    var blank_ok = false
    var pending_blank = false
    for line in lines {
        if line.len == 0 {
            pending_blank = blank_ok
            continue
        }
        let first = line[0].piece
        var leading = 0
        var counting = true
        for e in line {
            if counting && punct(e.piece, closers) { leading += 1 } else { counting = false }
        }
        // A line that goes on from the one before is indented once more.
        var level = depth - leading
        if level < 0 { level = 0 }
        if first.kind == PUNCT && punct(first, lexer.CONTINUES) { level += 1 }
        // The conditions of a function, under its signature.
        if first.kind == WORD && first.text == "where" { level += 1 }
        if pending_blank && leading == 0 { out.push("\n") }
        pending_blank = false
        out.push(text.repeat("    ", level))
        for k in 0..(line.len as int) {
            if k > 0 && space(line[k - 1].piece, line[k].piece, line[k].had) { out.push(" ") }
            out.push(line[k].piece.text)
        }
        out.push("\n")
        for e in line {
            if punct(e.piece, openers) {
                depth += 1
            } else if punct(e.piece, closers) {
                if depth > 0 { depth -= 1 }
            }
        }
        blank_ok = !punct(line[line.len - 1].piece, openers)
    }
    let made = text.concat(out)
    // What changed must be layout only.
    let before = meaning(src)?
    let after = meaning(made)?
    var same = before.len == after.len
    if same {
        for k in 0..(before.len as int) {
            if before[k] != after[k] { same = false }
        }
    }
    if !same { return Failed("internal error in the formatter: the result would not mean the same") }
    made
}

// The tokens of a text without what the layout may change: where each
// one is, and how many blank lines there are.
fn meaning(src: str) -> [str] ! Failed {
    let toks = lexer.lex(src) catch e { return Failed(e.msg) }
    var out: [str] = []
    for t in toks {
        match t.tok {
            lexer.Tok.Newline => {
                if out.len > 0 && out[out.len - 1] != "newline" { out.push("newline") }
            }
            // A file may end without a line of its own for that.
            lexer.Tok.Eof => {
                if out.len > 0 && out[out.len - 1] == "newline" { let _ = out.pop() }
                out.push("eof")
            }
            lexer.Tok.Ident(s) => out.push("ident {s}")
            lexer.Tok.Int(s) => out.push("int {s}")
            lexer.Tok.Float(s) => out.push("float {s}")
            lexer.Tok.Char(c) => out.push("char {c as u32}")
            lexer.Tok.Kw(k) => out.push("kw {k}")
            lexer.Tok.P(p) => out.push("p {p}")
            lexer.Tok.Str(parts) => {
                out.push("str {parts.len}")
                for part in parts {
                    match part {
                        lexer.Part.Lit(s) => out.push("  lit {s.len} {s}")
                        lexer.Part.Expr(s, _, _) => out.push("  expr {s.len} {s}")
                    }
                }
            }
        }
    }
    out
}
