// The compiler of Mou written in Mou. So far: the lexer, the parser, the
// loader of modules, the checker, the lowering to the middle form and the writing of C.
//
//     mou build compiler/main.mou -o mouc
//     ./mouc lex file.mou        prints the tokens of the file, as `mou lex` does
//     ./mouc tree file.mou       prints its syntax tree, as `mou tree` does
//     ./mouc modules file.mou    prints the program with all it imports, as
//                                `mou modules` does; a third argument says
//                                where the standard library is (`std`)
//     ./mouc decls file.mou      prints what its declarations say, as
//                                `mou decls` does
//     ./mouc types file.mou      prints what the checker finds out about each
//                                expression, as `mou types` does
//     ./mouc lowered file.mou    prints the program lowered to its middle
//                                form, as `mou lowered` does
//     ./mouc c file.mou          prints the C of the program, as `mou rawc`
//                                does; a fourth argument says where the
//                                runtime is (`src/runtime.c`)
//     ./mouc typetest            runs the functions on types over a fixed list,
//                                as `mou typetest` does

import std.io
import cgen
import check
import lexer
import load
import mir
import moves
import parser
import types

fn main() -> int ! io.Error {
    let args = io.args()
    if args.len == 1 && args[0] == "typetest" {
        for line in types.selftest() { io.print(line)? }
        return 0
    }
    if args.len < 2 || !(args[0] == "lex" || args[0] == "tree" || args[0] == "modules" || args[0] == "decls" || args[0] == "types" || args[0] == "lowered" || args[0] == "c") {
        io.eprint("usage: mouc lex|tree|modules|decls|types|lowered|c <file.mou>")?
        return 2
    }
    let src = io.read_file(args[1])?
    if args[0] == "modules" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        for line in load.dump(load.load(args[1], src, std_dir)) { io.print(line)? }
        return 0
    }
    if args[0] == "c" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let runtime_path = if args.len > 3 { args[3] } else { "src/runtime.c" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let checked = check.check(program)
        let mistakes = check.error_lines(checked)
        if mistakes.len > 0 {
            for line in mistakes { io.print(line)? }
            return 1
        }
        let lowered = mir.lower(program, checked)
        if lowered.errors.len > 0 {
            for e in lowered.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let lost = moves.check(lowered)
        if lost.len > 0 {
            for e in lost { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let runtime = io.read_file(runtime_path)?
        var paths: [str] = []
        for m in program.modules { paths.push(m.path) }
        let written = cgen.emit(lowered, paths, runtime) catch e {
            io.print("error 0:0 {e.msg}")?
            return 1
        }
        io.print(written)?
        return 0
    }
    if args[0] == "lowered" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        let checked = check.check(program)
        let mistakes = check.error_lines(checked)
        if mistakes.len > 0 {
            for line in mistakes { io.print(line)? }
            return 0
        }
        for line in mir.dump(mir.lower(program, checked)) { io.print(line)? }
        return 0
    }
    if args[0] == "types" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        for line in check.dump_types(check.check(program)) { io.print(line)? }
        return 0
    }
    if args[0] == "decls" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        for line in check.dump(check.declarations(program)) { io.print(line)? }
        return 0
    }
    if args[0] == "lex" {
        let toks = lexer.lex(src) catch e {
            io.print("error {e.line}:{e.col} {e.msg}")?
            return 1
        }
        for line in lexer.dump(toks) { io.print(line)? }
        return 0
    }
    let file = parser.parse(src) catch e {
        io.print("error {e.line}:{e.col} {e.msg}")?
        return 1
    }
    for line in parser.dump(file) { io.print(line)? }
    0
}
