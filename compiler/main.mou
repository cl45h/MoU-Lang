// The compiler of Mou written in Mou. So far: the lexer, the parser and
// the loader of modules.
//
//     mou build compiler/main.mou -o mouc
//     ./mouc lex file.mou        prints the tokens of the file, as `mou lex` does
//     ./mouc tree file.mou       prints its syntax tree, as `mou tree` does
//     ./mouc modules file.mou    prints the program with all it imports, as
//                                `mou modules` does; a third argument says
//                                where the standard library is (`std`)

import std.io
import lexer
import load
import parser

fn main() -> int ! io.Error {
    let args = io.args()
    if args.len < 2 || !(args[0] == "lex" || args[0] == "tree" || args[0] == "modules") {
        io.eprint("usage: mouc lex|tree|modules <file.mou>")?
        return 2
    }
    let src = io.read_file(args[1])?
    if args[0] == "modules" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        for line in load.dump(load.load(args[1], src, std_dir)) { io.print(line)? }
        return 0
    }
    if args[0] == "lex" {
        let toks = lexer.lex(src) catch e {
            io.print("error {e.line}:{e.col} {e.msg}")?
            return 1
        }
        for line in lexer.dump(toks) { io.print(line)? }
        return 0
    }
    let file = parser.parse(src) catch e {
        io.print("error {e.line}:{e.col} {e.msg}")?
        return 1
    }
    for line in parser.dump(file) { io.print(line)? }
    0
}
