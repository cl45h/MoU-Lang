// The compiler of Mou, written in Mou: the lexer, the parser, the loader
// of modules, the checker, the lowering to the middle form, the checks on
// it, and the writing of C. It builds itself: see `bootstrap.sh`.
//
//     ./mou check file.mou       says the mistakes of the program
//     ./mou run file.mou         builds it and runs it
//     ./mou interp file.mou      runs it in the interpreter, without a C compiler
//     ./mou build file.mou       builds it: `-o output`, `-l library`
//     ./mou test file.mou        runs its tests
//     ./mou effects file.mou     prints what each function can do
//     ./mou fmt file.mou         gives it the standard layout; `--check` only asks
//     ./mou repl                 an interactive session
//     ./mou bind header.h        prints the `import c` block of a header of C
//
// And each stage by itself, as lines of text, which the tests compare:
//
//     ./mou lex file.mou         the tokens of the file
//     ./mou tree file.mou        its syntax tree
//     ./mou modules file.mou     the program with all it imports; a third
//                                argument says where the standard library
//                                is (`std`)
//     ./mou decls file.mou       what its declarations say
//     ./mou types file.mou       what the checker finds out about each expression
//     ./mou lowered file.mou     the program lowered to its middle form
//     ./mou fx file.mou          the effects of each function
//     ./mou c file.mou           the C of the program; a fourth argument
//                                says where the runtime is (`runtime/runtime.c`)
//     ./mou typetest             the functions on types over a fixed list

import std.io
import std.text
import bind
import cgen
import check
import consts
import driver
import effects
import lexer
import load
import mir
import moves
import parser
import repl
import types

fn main() -> int ! io.Error {
    let args = io.args()
    if args.len == 1 && args[0] == "typetest" {
        for line in types.selftest() { io.print(line)? }
        return 0
    }
    if args.len >= 1 && args[0] == "repl" {
        let h = driver.home()
        repl.repl(h.std_dir, h.runtime)?
        return 0
    }
    if args.len >= 2 && args[0] == "bind" {
        let alias = if args.len > 2 { args[2] } else { "" }
        let lines = bind.bind(args[1], alias) catch e {
            io.eprint("mou: {e.msg}")?
            return 1
        }
        for line in lines { io.print(line)? }
        return 0
    }
    if args.len >= 2 && args[0] == "check" { return driver.check_file(args[1])? }
    if args.len >= 2 && args[0] == "run" {
        var given: [str] = []
        for k in 2..(args.len as int) { given.push(args[k]) }
        return driver.run_file(args[1], given)?
    }
    if args.len >= 2 && args[0] == "fmt" { return driver.fmt_file(args[1], args.len > 2 && args[2] == "--check")? }
    if args.len >= 2 && args[0] == "interp" {
        var given: [str] = []
        for k in 2..(args.len as int) { given.push(args[k]) }
        return driver.interp_file(args[1], given)?
    }
    if args.len >= 2 && args[0] == "effects" { return driver.effects_file(args[1])? }
    if args.len >= 2 && args[0] == "build" {
        // `-o output`, and `-l name` for each library of C to link.
        var output: str? = None
        var libs: [str] = []
        var k = 2
        while k < (args.len as int) {
            if k + 1 < (args.len as int) && args[k] == "-o" {
                output = Some(args[k + 1])
            } else if k + 1 < (args.len as int) && args[k] == "-l" {
                libs.push(args[k + 1])
            } else {
                io.eprint("usage: mou build <file.mou> [-o <output>] [-l <library>]...")?
                return 2
            }
            k += 2
        }
        return driver.build_file(args[1], output, libs)?
    }
    if args.len >= 2 && args[0] == "test" {
        // `mou test file.mou [part of a name] [--all]`
        var filter: str? = None
        var all = false
        for k in 2..(args.len as int) {
            if args[k] == "--all" {
                all = true
            } else if args[k] == "--native" {
                // Every test runs compiled.
            } else if text.starts_with(args[k], "--") {
                io.eprint("mou: `test` does not know `{args[k]}`: it takes `--all`")?
                return 2
            } else {
                filter = Some(args[k])
            }
        }
        return driver.test_file(args[1], filter, all)?
    }
    if args.len < 2 || !(args[0] == "lex" || args[0] == "tree" || args[0] == "modules" || args[0] == "decls" || args[0] == "types" || args[0] == "lowered" || args[0] == "c" || args[0] == "fx") {
        io.eprint("usage: mou check|run|build|test|effects|fmt <file.mou>, mou repl, mou bind <header.h>\n       mou lex|tree|modules|decls|types|lowered|fx|c <file.mou>")?
        return 2
    }
    let src = io.read_file(args[1])?
    if args[0] == "modules" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        for line in load.dump(load.load(args[1], src, std_dir)) { io.print(line)? }
        return 0
    }
    if args[0] == "fx" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        let checked = check.check(program)
        let mistakes = check.error_lines(checked)
        if mistakes.len > 0 {
            for line in mistakes { io.print(line)? }
            return 0
        }
        let lowered = mir.lower(program, checked)
        if lowered.errors.len > 0 {
            for e in lowered.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        for line in effects.dump(lowered) { io.print(line)? }
        for e in effects.check(lowered) { io.print("error {e.line}:{e.col} {e.msg}")? }
        return 0
    }
    if args[0] == "c" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let runtime_path = if args.len > 3 { args[3] } else { "runtime/runtime.c" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let checked = check.check(program)
        let mistakes = check.error_lines(checked)
        if mistakes.len > 0 {
            for line in mistakes { io.print(line)? }
            return 1
        }
        let lowered = mir.lower(program, checked)
        if lowered.errors.len > 0 {
            for e in lowered.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let lost = moves.check(lowered)
        if lost.len > 0 {
            for e in lost { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let ruled = effects.check(lowered)
        if ruled.len > 0 {
            for e in ruled { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let worked = consts.eval(lowered)
        if worked.errors.len > 0 {
            for e in worked.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 1
        }
        let runtime = io.read_file(runtime_path)?
        var paths: [str] = []
        for m in program.modules { paths.push(m.path) }
        let written = cgen.emit(worked.program, paths, runtime, worked.values) catch e {
            io.print("error 0:0 {e.msg}")?
            return 1
        }
        io.print(written)?
        return 0
    }
    if args[0] == "lowered" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        let checked = check.check(program)
        let mistakes = check.error_lines(checked)
        if mistakes.len > 0 {
            for line in mistakes { io.print(line)? }
            return 0
        }
        for line in mir.dump(mir.lower(program, checked)) { io.print(line)? }
        return 0
    }
    if args[0] == "types" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        for line in check.dump_types(check.check(program)) { io.print(line)? }
        return 0
    }
    if args[0] == "decls" {
        let std_dir = if args.len > 2 { args[2] } else { "std" }
        let program = load.load(args[1], src, std_dir)
        if program.errors.len > 0 {
            for e in program.errors { io.print("error {e.line}:{e.col} {e.msg}")? }
            return 0
        }
        for line in check.dump(check.declarations(program)) { io.print(line)? }
        return 0
    }
    if args[0] == "lex" {
        let toks = lexer.lex(src) catch e {
            io.print("error {e.line}:{e.col} {e.msg}")?
            return 1
        }
        for line in lexer.dump(toks) { io.print(line)? }
        return 0
    }
    let file = parser.parse(src) catch e {
        io.print("error {e.line}:{e.col} {e.msg}")?
        return 1
    }
    for line in parser.dump(file) { io.print(line)? }
    0
}
